{
  "name": "@ledgerhq/hw-transport",
  "version": "6.36.0",
  "description": "Ledger Hardware Wallet common interface of the communication layer",
  "keywords": [
    "Ledger",
    "LedgerWallet",
    "NanoS",
    "Blue",
    "Hardware Wallet"
  ],
  "homepage": "https://github.com/LedgerHQ/ts-libs/tree/main/libs/hw-transport",
  "bugs": {
    "url": "https://github.com/LedgerHQ/ts-libs/issues"
  },
  "license": "Apache-2.0",
  "files": [
    "lib",
    "lib-es",
    "src",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/LedgerHQ/ts-libs.git"
  },
  "main": "lib/Transport.js",
  "module": "lib-es/Transport.js",
  "types": "lib/Transport.d.ts",
  "typesVersions": {
    "*": {
      "errors": [
        "lib/errors.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "@ledgerhq/source": "./src/Transport.ts",
      "import": "./lib-es/Transport.js",
      "require": "./lib/Transport.js",
      "default": "./lib/Transport.js"
    },
    "./errors": {
      "@ledgerhq/source": "./src/errors.ts",
      "import": "./lib-es/errors.js",
      "require": "./lib/errors.js",
      "default": "./lib/errors.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "events": "^3.3.0",
    "@ledgerhq/devices": "8.18.0",
    "@ledgerhq/logs": "6.19.0"
  },
  "devDependencies": {
    "@swc/core": "1.16.1",
    "@swc/jest": "0.2.39",
    "@types/jest": "30.0.0",
    "@types/node": "26.4.0",
    "jest": "30.5.0",
    "jest-sonar": "0.2.16",
    "oxlint": "1.80.0",
    "typescript": "7.0.2"
  },
  "scripts": {
    "clean": "rm -rf lib lib-es",
    "build": "tsc --project tsconfig.build.json && tsc --project tsconfig.build.json -m esnext --moduleResolution bundler --outDir lib-es",
    "lint": "oxlint ./src",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "coverage": "jest --coverage --passWithNoTests"
  }
}